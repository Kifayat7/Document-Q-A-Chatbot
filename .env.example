# Copy to .env and fill in. NEVER commit .env.

# ---- LLM (openai | anthropic | ollama) ----
LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini        # defaults per provider if empty
LLM_TEMPERATURE=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Embeddings (huggingface = local, no key | openai) ----
# Changing these later requires re-uploading your documents.
EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Ingestion ----
MAX_FILE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
ENABLE_OCR=false

# ---- Retrieval ----
TOP_K=4
MIN_RELEVANCE=0.0
HISTORY_TURNS=3

# ---- Behaviour / paths ----
PERSIST_HISTORY=true
# DOCUMIND_DATA_DIR=./data
# CHROMA_DIR=./vectorstore/chroma_db
